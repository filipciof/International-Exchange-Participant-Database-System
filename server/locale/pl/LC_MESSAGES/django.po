#: eauth/utils.py:27
msgid "RYE District 2231 - Activate Your Account"
msgstr "RYE Dystrykt 2231 - Aktywuj swoje konto"

#: eauth/utils.py:29
#, python-format
msgid ""
"Hello,\n"
"\n"
"An account has been created for you in the Rotary District 2231 Youth Exchange Management Service.\n"
"\n"
"Please click the link below to set your password and activate your account:\n"
"%(link)s\n"
"\n"
"If you did not expect this email, you can safely ignore it."
msgstr ""
"Witaj,\n"
"\n"
"W serwisie RYE Dystryktu 2231 zostało utworzone dla Ciebie konto.\n"
"\n"
"Kliknij poniższy link, aby ustawić hasło i aktywować swoje konto:\n"
"%(link)s\n"
"\n"
"Jeśli nie spodziewałeś/aś się tego emaila, możesz go zignorować."

#: eauth/utils.py:43
msgid "RYE District 2231 - Reset Your Password"
msgstr "RYE Dystrykt 2231 - Zresetuj hasło"

#: eauth/utils.py:45
#, python-format
msgid ""
"Hello,\n"
"\n"
"We received a request to reset your password.\n"
"\n"
"Please click the link below to set a new password:\n"
"%(link)s\n"
"\n"
"If you did not request this, you can safely ignore this email."
msgstr ""
"Witaj,\n"
"\n"
"Otrzymaliśmy prośbę o zresetowanie Twojego hasła.\n"
"\n"
"Kliknij poniższy link, aby ustawić nowe hasło:\n"
"%(link)s\n"
"\n"
"Jeśli nie prosiłeś/aś o to, możesz zignorować ten email."

#: eauth/utils.py:59
msgid "RYE District 2231 - Account Activated"
msgstr "RYE Dystrykt 2231 - Konto aktywowane"

#: eauth/utils.py:61
#, python-format
msgid ""
"Hello,\n"
"\n"
"Your account has been successfully activated.\n"
"\n"
"You can now sign in at:\n"
"%(link)s"
msgstr ""
"Witaj,\n"
"\n"
"Twoje konto zostało pomyślnie aktywowane.\n"
"\n"
"Możesz teraz zalogować się na:\n"
"%(link)s"

#: eauth/utils.py:74
msgid "RYE District 2231 - Password Changed"
msgstr "RYE Dystrykt 2231 - Hasło zmienione"

#: eauth/utils.py:76
msgid ""
"Hello,\n"
"\n"
"Your password has been successfully changed.\n"
"\n"
"If you did not make this change, please contact us immediately."
msgstr ""
"Witaj,\n"
"\n"
"Twoje hasło zostało pomyślnie zmienione.\n"
"\n"
"Jeśli nie dokonałeś/aś tej zmiany, skontaktuj się z nami natychmiast."

#: eauth/utils.py:105
msgid "RYE District 2231 - Verify Email Change"
msgstr "RYE Dystrykt 2231 - Potwierdź zmianę adresu email"

#: eauth/utils.py:107
#, python-format
msgid ""
"Hello,\n"
"\n"
"A request was made to change your account email to this address.\n"
"\n"
"Please click the link below to confirm the change:\n"
"%(link)s\n"
"\n"
"If you did not expect this email, you can safely ignore it."
msgstr ""
"Witaj,\n"
"\n"
"Złożono prośbę o zmianę adresu email Twojego konta na ten adres.\n"
"\n"
"Kliknij poniższy link, aby potwierdzić zmianę:\n"
"%(link)s\n"
"\n"
"Jeśli nie spodziewałeś/aś się tego emaila, możesz go zignorować."

