#: eauth/views.py:164
msgid "Password reset successfully."
msgstr "Hasło zostało pomyślnie zresetowane."

#: eauth/views.py:169
msgid "Account activated successfully."
msgstr "Konto zostało pomyślnie aktywowane."

#: eauth/views.py:185
msgid "Verification link is invalid or has expired."
msgstr "Link weryfikacyjny jest nieprawidłowy lub wygasł."

